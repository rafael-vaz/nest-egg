{
  "name": "nest-egg",
  "description": "A personal finance tracker for managing transactions and keeping wallet balance in sync automatically.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafael-vaz/nest-egg.git"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "deploy": "firebase deploy",
    "deploy:hosting": "npm run deploy -w apps/web",
    "deploy:functions": "npm run deploy -w apps/functions",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "deploy:storage-rules": "firebase deploy --only storage"
  }
}
